[user]
	name = motikix
	email = 25551031+motikix@users.noreply.github.com
[core]
	quotepath = false
	autocrlf = false
	pager = hunk pager
[init]
	defaultBranch = main
[pull]
	rebase = false
[diff]
	tool = hunk
[difftool "hunk"]
	cmd = ["hunk", "difftool", "$LOCAL", "$REMOTE", "$MERGED"]
[difftool]
	prompt = false
[merge]
	conflictstyle = zdiff3
[ghq]
	root = ~/.local/src
[url "https://"]
	insteadOf = git://
[url "https://github.com/"]
	insteadOf = git@github.com:
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
